# ============================================================
# REFINE — environment variable reference
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must NEVER be committed.
# ============================================================

# ── Postgres (Docker) ────────────────────────────────────────
POSTGRES_USER=refine
POSTGRES_PASSWORD=<choose a strong local password>
POSTGRES_DB=refine

# Full connection string assembled from the above
DATABASE_URL=postgresql://refine:<your-password>@localhost:5432/refine

# ── Encryption ───────────────────────────────────────────────
# 64-character hex string (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER regenerate after data exists — existing ciphertext becomes unreadable.
ENCRYPTION_KEY=<64-char hex string>

# ── Session ──────────────────────────────────────────────────
# Random string, 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=<random 32+ char string>

# ── Auth ─────────────────────────────────────────────────────
# Bcrypt hash of your chosen passphrase. Generate with:
#   npm run setup:passphrase
# $ signs must be escaped as \$ — the setup:passphrase script does this automatically
AUTH_PASSPHRASE_HASH=\$2b\$12\$<rest of bcrypt hash from setup:passphrase>

# ── Anthropic (not needed until Phase 2) ─────────────────────
ANTHROPIC_API_KEY=<your Anthropic API key>

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
