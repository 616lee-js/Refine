# ============================================================
# REFINE — environment variable reference
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must NEVER be committed.
# ============================================================

# ── Postgres ─────────────────────────────────────────────────
# Local (Docker) values. Only POSTGRES_* are read by docker-compose;
# the app itself reads DATABASE_URL exclusively.
POSTGRES_USER=refine
POSTGRES_PASSWORD=<choose a strong local password>
POSTGRES_DB=refine

# The app's connection string. Locally this is the Docker Postgres below.
# Deployed, this is the Supabase POOLED string (Supavisor transaction mode,
# port 6543) — never the direct one.
DATABASE_URL=postgresql://refine:<your-password>@localhost:5432/refine

# Migrations only — read by drizzle.config.ts, never by the app.
# Supabase DIRECT connection, port 5432. Set this in your local shell when
# running migrations; it does not need to exist in Vercel.
# If db.<ref>.supabase.co is IPv6-only from your network, use the
# session-mode pooler (port 5432 on pooler.supabase.com) instead.
DATABASE_URL_DIRECT=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# ── Encryption ───────────────────────────────────────────────
# 64-character hex string (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER regenerate after data exists — existing ciphertext becomes unreadable.
#
# MUST be byte-identical in every environment reading the same database — that
# means Vercel AND this file, because the CLI scripts write to production
# through .env.local. A mismatch raises no clear error; it presents as missing
# data. The app logs a SHA-256 fingerprint of this key at startup so
# environments can be compared without exposing the value.
ENCRYPTION_KEY=<64-char hex string>

# ── Email HMAC ────────────────────────────────────────────────
# 64-character hex string (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER regenerate after users exist — existing email_hmac values become invalid
# and login lookups will fail for all users.
#
# Same identical-everywhere rule as ENCRYPTION_KEY — and this one has no clean
# failure mode at all: a mismatch makes every login return "invalid credentials"
# and every account appear not to exist.
EMAIL_HMAC_KEY=<64-char hex string>

# ── Session ──────────────────────────────────────────────────
# Random string, 32+ characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=<random 32+ char string>

# ── Anthropic ────────────────────────────────────────────────
# Server-side only. Never log, never expose in errors, never send to browser.
# Not needed by the CLI scripts (seed, reset, migrations) — keep it out of .env.
ANTHROPIC_API_KEY=<your Anthropic API key>

# ── Admin access ─────────────────────────────────────────────
# Comma-separated user UUIDs allowed to view /admin/*. Unset or empty means
# nobody is an admin (fail closed). Find your id in the users table.
ADMIN_USER_IDS=

# ── Vercel Cron (deployed only) ──────────────────────────────
# Vercel sends "Authorization: Bearer <CRON_SECRET>" to scheduled routes when
# this is set. /api/health rejects requests without it. Keeps Supabase from
# pausing after 7 days of inactivity.
CRON_SECRET=<random 32+ char string>

# ── NEXT_PUBLIC_* ────────────────────────────────────────────
# None. Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle.
# No secret in this file may ever carry that prefix.
